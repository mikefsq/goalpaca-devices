#!/usr/bin/env bash

# Build one alpacahurd-<driver> package per architecture, with a disabled device entry.
# Requires Go, dpkg-deb, and file; no root access needed.
# Usage: build/build-deb [-d driver] [-v version]

set -o pipefail

SCRIPT_DIR=$(cd "${BASH_SOURCE%/*}" && pwd)
SRC_DIR=$(cd "$SCRIPT_DIR/.." && pwd)

PREFIX=alpacahurd
MAINTAINER="mikefsq <162642838+mikefsq@users.noreply.github.com>"
HOMEPAGE=https://github.com/mikefsq/goalpaca-devices

# Package drivers supporting -config and -discovery without vendor SDKs.
# The simulator is built into alpacahurd; SDK drivers need separate packaging.
DRIVERS="
    asiair
    asiam5
    asieaf
    asiefw
    astrocam
    focuscube
    focuslynx
    mgpbox
    oasisfoc
    oasisfw
    onstep
    ptpcam
    rst
    smpro-focuser
    smpro-switch
    tenmicron
    unihedron
"

# Drivers whose registered driver names differ from their binary name get a
# symlink per name, because alpacahurd resolves a driver by looking for a file
# called exactly that. One line per module: the module name, then the names it
# registers that its binary is not already called.
ALIASES="
    asiair asiair-switch
"

# Drivers whose hardware exists only on a Raspberry Pi: I2C/SPI/UART hats for
# smpro, the ASIAIR's own switch for asiair. Their packages are arm64 only.
ARM64_ONLY="smpro-switch smpro-focuser asiair"

arches="amd64 arm64"
outdir=$SRC_DIR/dist
version=
drivers=

usage () {
    cat <<EOF
Usage: build-deb [-d DRIVERS] [-a ARCHES] [-o OUTDIR] [-v VERSION]

Options:
 -d DRIVERS    space-separated driver names   [default: every packageable one]
 -a ARCHES     space-separated Debian architectures: amd64, arm64, armhf
               [default: $arches]
 -o OUTDIR     directory for the .deb files   [default: $outdir]
 -v VERSION    package version. A tagged commit takes its version from the
               tag; any other commit gets a ~git suffix that sorts below the
               next release.
 -h            show this help

Drivers built by default:
$(echo $DRIVERS | tr ' ' '\n' | sed 's/^/  /')
EOF
}

while getopts "d:a:o:v:h" o; do
    case "${o}" in
        d) drivers=$OPTARG ;;
        a) arches=$OPTARG ;;
        o) outdir=$OPTARG ;;
        v) version=$OPTARG ;;
        h) usage; exit 0 ;;
        *) usage >&2; exit 1 ;;
    esac
done

for t in go dpkg-deb file; do
    command -v "$t" >/dev/null 2>&1 || { echo "build-deb: $t not found" >&2; exit 1; }
done

[[ -n $drivers ]] || drivers=$DRIVERS

goarch () {
    case "$1" in
        amd64) echo "amd64 " ;;
        arm64) echo "arm64 " ;;
        armhf) echo "arm 7" ;;
        *)     return 1 ;;
    esac
}

# aliases_for prints the extra driver names a module registers, or nothing.
# Drivers whose module directory is not their own name. The SM Pro board is one
# Go module serving two ASCOM device types, with a binary for each: the two open
# disjoint hardware (I2C/SPI/PWM against the stepper UART), so they run as
# separate processes.
MODULE_DIRS="
    smpro-switch smpro
    smpro-focuser smpro
"

# module_for prints the module directory a driver is built from, defaulting to
# the driver's own name.
module_for () {
    local m
    m=$(echo "$MODULE_DIRS" | awk -v d="$1" '$1 == d { print $2; exit }')
    echo "${m:-$1}"
}

aliases_for () {
    echo "$ALIASES" | awk -v m="$1" '$1 == m { $1 = ""; print; exit }'
}

# resolve_version derives the package version, shared by every package built in
# one run: the modules carry no version of their own, and a herd assembled from
# one commit is easier to reason about than fourteen independent version lines.
resolve_version () {
    local tag stamp sha
    tag=$(git -C "$SRC_DIR" describe --exact-match --tags HEAD 2>/dev/null)
    if [[ $tag == v[0-9]* ]]; then
        echo "${tag#v}"
        return
    fi
    stamp=$(git -C "$SRC_DIR" log -1 --format=%cd --date=format:%Y%m%d 2>/dev/null)
    sha=$(git -C "$SRC_DIR" rev-parse --short=7 HEAD 2>/dev/null)
    if [[ -z $stamp || -z $sha ]]; then echo "0.0.0"; else echo "0.0.0~git$stamp.$sha"; fi
}

check_package () {
    local deb=$1 arch=$2 driver=$3 root rc=0
    root=$(mktemp -d) || return 1
    dpkg-deb -x "$deb" "$root" || { rm -rf "$root"; return 1; }

    local got
    got=$(dpkg-deb -f "$deb" Architecture)
    [[ $got == "$arch" ]] || { echo "$deb: Architecture is $got, expected $arch" >&2; rc=1; }

    if ! file "$root/usr/bin/$driver" | grep -q "statically linked"; then
        echo "$deb: the binary is not statically linked -- was CGO_ENABLED=0 set?" >&2
        rc=1
    fi

    # alpacahurd resolves a driver by name, so a package that does not depend on
    # it installs a binary nothing will ever launch.
    dpkg-deb -f "$deb" Depends | grep -q '\balpacahurd\b' \
        || { echo "$deb: does not depend on alpacahurd" >&2; rc=1; }

    local alias
    for alias in $(aliases_for "$driver"); do
        [[ -L $root/usr/bin/$alias ]] || { echo "$deb: missing alias symlink $alias" >&2; rc=1; }
    done

    rm -rf "$root"
    return $rc
}

build_one () {
    local driver=$1 arch=$2 pair ga gm root bin size dir
    pair=$(goarch "$arch") || { echo "build-deb: unknown architecture '$arch'" >&2; return 1; }
    read -r ga gm <<<"$pair"

    dir=$(module_for "$driver")
    [[ -d $SRC_DIR/$dir ]] || { echo "build-deb: no module directory '$dir'" >&2; return 1; }

    root=$(mktemp -d) || return 1
    chmod 0755 "$root"
    bin=$root/usr/bin/$driver
    mkdir -p "$root/usr/bin" "$root/usr/share/doc/$PREFIX-$driver" "$root/DEBIAN"

    # GOWORK=off builds from the module's committed go.mod, so a package can only
    # be built from dependencies a plain clone resolves. A driver that needs a
    # sibling checkout fails here rather than on a runner.
    if ! ( cd "$SRC_DIR/$dir" && CGO_ENABLED=0 GOOS=linux GOARCH="$ga" GOARM="$gm" \
        GOFLAGS=-mod=readonly GOWORK=off \
        go build -trimpath -ldflags "-s -w" -o "$bin" "./cmd/$driver" ); then
        rm -rf "$root"
        return 1
    fi
    chmod 0755 "$bin"

    local alias
    for alias in $(aliases_for "$driver"); do
        ln -s "$driver" "$root/usr/bin/$alias"
    done

    write_copyright "$root/usr/share/doc/$PREFIX-$driver/copyright"
    write_changelog "$driver" | gzip -9n > "$root/usr/share/doc/$PREFIX-$driver/changelog.Debian.gz"
    chmod 0644 "$root/usr/share/doc/$PREFIX-$driver/changelog.Debian.gz"

    size=$(du -ks "$root" | cut -f1)
    write_control "$driver" "$arch" "$size" > "$root/DEBIAN/control"
    write_maintainer_scripts "$root/DEBIAN" "$driver"

    mkdir -p "$outdir"
    local deb=$outdir/${PREFIX}-${driver}_${version}_${arch}.deb
    if ! dpkg-deb --root-owner-group -Zxz --build "$root" "$deb" >/dev/null; then
        rm -rf "$root"; return 1
    fi
    rm -rf "$root"

    check_package "$deb" "$arch" "$driver" || return 1
    echo "  $(printf '%-28s' "$(basename "$deb")") $(dpkg-deb -f "$deb" Installed-Size) KiB"
}

write_control () {
    local driver=$1 arch=$2 size=$3
    cat <<EOF
Package: $PREFIX-$driver
Version: $version
Architecture: $arch
Installed-Size: $size
Maintainer: $MAINTAINER
Section: science
Priority: optional
Homepage: $HOMEPAGE
Depends: $PREFIX
Description: $driver Alpaca driver for alpacahurd
 The $driver device driver, built as its own binary. alpacahurd runs it as a
 separate process and answers Alpaca discovery on its behalf, so this driver
 can be installed, upgraded and removed without disturbing the rest of the
 herd.
 .
 Installing this package seeds a disabled entry in
 /etc/alpacahurd/devices.d/$driver.json. Edit it for your hardware, set
 "enable": true, and restart alpacahurd.
EOF
}

write_copyright () {
    {
        cat <<EOF
Format: https://www.debian.org/doc/packaging-manuals/copyright-format/1.0/
Upstream-Name: goalpaca-devices
Source: $HOMEPAGE

Files: *
Copyright: $(sed -n 's/^Copyright \(.*\)$/\1/p' "$SRC_DIR/LICENSE" | head -1)
License: MIT

License: MIT
EOF
        sed -e '1,/^$/d' -e 's/^$/./' -e 's/^/ /' "$SRC_DIR/LICENSE"
    } > "$1"
    chmod 0644 "$1"
}

write_changelog () {
    cat <<EOF
$PREFIX-$1 ($version) unstable; urgency=medium

  * Build from $(git -C "$SRC_DIR" rev-parse HEAD 2>/dev/null || echo "an untracked tree").

 -- $MAINTAINER  $(git -C "$SRC_DIR" log -1 --format=%cD 2>/dev/null || date -R)
EOF
}

# write_maintainer_scripts writes postinst and postrm. The device file is
# generated by the driver itself on first configure rather than shipped as a
# dpkg conffile, so an upgrade never prompts and never overwrites an edited
# entry -- the same arrangement the alpacahurd package uses for hurd.json.
write_maintainer_scripts () {
    local d=$1 driver=$2

    sed "s/@DRIVER@/$driver/g" > "$d/postinst" <<'EOF'
#!/bin/sh
set -e

update_registry() {
binary=$1
registry_file=$2
runtime_path=${3:-$binary}
action=${4:-add}
case "$runtime_path" in /*) ;; *) echo 'installed binary path must be absolute' >&2; exit 1 ;; esac
case "$runtime_path" in *'
'*) echo 'installed binary path must be a single line' >&2; exit 1 ;; esac
[ "$action" != remove ] || [ -f "$registry_file" ] || exit 0
mkdir -p "$(dirname "$registry_file")"
# Serialize concurrent installers while replacing the list atomically.
lock="$registry_file.lock"
attempt=0
until mkdir "$lock" 2>/dev/null; do
    attempt=$((attempt + 1))
    [ "$attempt" -lt 30 ] || { echo "registry is locked: $registry_file" >&2; exit 1; }
    sleep 1
done
tmp=
trap 'rm -f "$tmp"; rmdir "$lock"' EXIT
trap 'exit 1' HUP INT TERM
tmp=$(mktemp "$registry_file.XXXXXX")
if [ -f "$registry_file" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        [ "$line" = "$runtime_path" ] || printf '%s\n' "$line"
    done < "$registry_file" > "$tmp"
fi
if [ "$action" != remove ]; then
    printf '%s\n' "$runtime_path" >> "$tmp"
fi
chmod 0644 "$tmp"
mv -f "$tmp" "$registry_file"

}

DEVICES_DIR=/etc/alpacahurd/devices.d
ENTRY="$DEVICES_DIR/@DRIVER@.json"

if [ "$1" = configure ]; then
	(update_registry /usr/bin/@DRIVER@ /etc/alpacahurd/drivers.conf)
	mkdir -p "$DEVICES_DIR"
	# The template documents every key at its default, all commented, and
	# sets "enable": false, so it changes nothing until it is edited. An
	# existing file is kept: an upgrade leaves an edited entry alone.
	if [ ! -f "$ENTRY" ]; then
		/usr/bin/@DRIVER@ -schema commented > "$ENTRY"
		chmod 0644 "$ENTRY"
		echo "seeded $ENTRY -- edit it and set \"enable\": true"
	fi
fi

# The orchestrator picks up a new driver binary and a new device file on a
# reload; a restart is only needed to bind a new port.
if [ -d /run/systemd/system ] && [ "$1" = configure ]; then
	systemctl reload alpacahurd.service >/dev/null 2>&1 || true
fi

exit 0
EOF

    sed "s/@DRIVER@/$driver/g" > "$d/postrm" <<'EOF'
#!/bin/sh
set -e

update_registry() {
binary=$1
registry_file=$2
runtime_path=${3:-$binary}
action=${4:-add}
case "$runtime_path" in /*) ;; *) echo 'installed binary path must be absolute' >&2; exit 1 ;; esac
case "$runtime_path" in *'
'*) echo 'installed binary path must be a single line' >&2; exit 1 ;; esac
[ "$action" != remove ] || [ -f "$registry_file" ] || exit 0
mkdir -p "$(dirname "$registry_file")"
# Serialize concurrent installers while replacing the list atomically.
lock="$registry_file.lock"
attempt=0
until mkdir "$lock" 2>/dev/null; do
    attempt=$((attempt + 1))
    [ "$attempt" -lt 30 ] || { echo "registry is locked: $registry_file" >&2; exit 1; }
    sleep 1
done
tmp=
trap 'rm -f "$tmp"; rmdir "$lock"' EXIT
trap 'exit 1' HUP INT TERM
tmp=$(mktemp "$registry_file.XXXXXX")
if [ -f "$registry_file" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        [ "$line" = "$runtime_path" ] || printf '%s\n' "$line"
    done < "$registry_file" > "$tmp"
fi
if [ "$action" != remove ]; then
    printf '%s\n' "$runtime_path" >> "$tmp"
fi
chmod 0644 "$tmp"
mv -f "$tmp" "$registry_file"

}

case "$1" in
remove|purge)
	(update_registry /usr/bin/@DRIVER@ /etc/alpacahurd/drivers.conf /usr/bin/@DRIVER@ remove)
	;;
esac

case "$1" in
purge)
	# purge removes the entry this package generated. remove keeps it, so
	# reinstalling the driver finds the configuration it had.
	rm -f /etc/alpacahurd/devices.d/@DRIVER@.json
	;;
esac

if [ -d /run/systemd/system ] && [ "$1" = remove ]; then
	systemctl reload alpacahurd.service >/dev/null 2>&1 || true
fi

exit 0
EOF

    chmod 0755 "$d/postinst" "$d/postrm"
}

[[ -n $version ]] || version=$(resolve_version)

rc=0
built=0
failed=()
echo "building $PREFIX-* $version"
for driver in $drivers; do
    for arch in $arches; do
        # A Pi-only driver has no meaningful amd64 build: its hardware is the
        # Pi's own buses.
        if [[ " $ARM64_ONLY " == *" $driver "* && $arch != arm64 ]]; then
            continue
        fi
        if build_one "$driver" "$arch"; then
            built=$((built + 1))
        else
            failed+=("$driver/$arch")
            rc=1
        fi
    done
done

echo "build-deb: built $built package(s) in $outdir"
if (( ${#failed[@]} )); then
    echo "build-deb: failed: ${failed[*]}" >&2
fi
exit $rc
